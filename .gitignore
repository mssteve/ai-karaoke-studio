# Dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/

# Generated builds and Windows packages
dist/
dist-electron/
release/
/zip/
out/
*.appx
*.appxbundle
*.exe
*.msi
*.msix
*.msixbundle
*.nupkg
*.blockmap
.qa*

# TypeScript and Vite generated state
*.tsbuildinfo
.vite/
/vite.config.js
/vite.config.d.ts
/src/types.js
/src/types.js.map

# QA files and directories, case-insensitive, at any depth.
# Already tracked files remain tracked; see AGENTS.md.
*[qQ][aA]*

# Temporary profiles and coverage
test-results/
coverage/
.nyc_output/
.profiles/
.electron-profile/
test-profile*/

# Local AI model and runtime downloads
.cache/
.huggingface/
.models/
models/
.runtime/
runtime/
onnx-models/

# Environment files, credentials, and local secrets
.env
.env.*
!.env.example
!.env.template
.secrets/
secrets/
credentials*.json
service-account*.json
*.secret

# Signing certificates and private keys
*.pfx
*.p12
*.pem
*.key
*.pvk
*.snk
*.cer
*.crt
*.p7b

# Release locks, one-use capabilities, and owned scratch stages.
# Nested dependency, cache, and runtime trees live under .release-source-*.
# These rules must not match tracked source, scripts, icons, or approvals.
/.deploy-release.lock
/.release.lock
/.release-capability
/.release-capability.consumed-*
/.release-source-*/
/.release-staging-*/
/.release-backup-*/
/.qa-approved-*/

# Logs, diagnostics, and temporary files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.tmp/
tmp/
temp/

# Editors and operating-system metadata
.vscode/
.idea/
*.code-workspace
.vs/
.DS_Store
Thumbs.db
Desktop.ini

# Squad local runtime state; canonical skills, decisions, and agent records remain visible
.copilot/mcp-config.json
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.first-run
.squad/casting/history.json
.squad/casting/registry.json
.squad/identity/now.md
.squad-workstream
